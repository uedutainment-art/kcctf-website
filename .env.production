# 프로덕션 빌드용 공개 플래그 (NEXT_PUBLIC_* — 클라이언트 노출, 비밀 아님)
# .env.local 은 gitignore 라 Firebase 배포 빌드에서 제외됨 → 배포 시 이 파일이 값을 제공.
# 로컬 next dev 에는 .env.local 이 계속 우선 적용됨(이 파일은 production 빌드에서만 로드).
NEXT_PUBLIC_SITE_URL=https://kcctf.org
NEXT_PUBLIC_EARLYBIRD_DEADLINE=
NEXT_PUBLIC_HOTEL_PDF_URL=https://drive.google.com/file/d/17RO012mb5sEw8LhAMQuF0sU7xUB6qWfA/preview
NEXT_PUBLIC_SHOW_HOTEL_PACKAGES=true
NEXT_PUBLIC_SHOW_CITY_GUIDE=false
# Travel 섹션 (호텔·오시는 길·Good to Know·Eat Out) — 2026-07-21 오픈
NEXT_PUBLIC_SHOW_TRAVEL=true
NEXT_PUBLIC_SHOW_LOGISTICS=false
NEXT_PUBLIC_SHOW_CONCERT_VENUE=true
NEXT_PUBLIC_SHOW_ACCOMMODATION=true
NEXT_PUBLIC_SHOW_TICKETS=true
NEXT_PUBLIC_TICKETS_COMING_SOON=true
NEXT_PUBLIC_REGISTRATION_OPEN=true
